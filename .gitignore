# Publish only the lightweight, curated tree. Historical workspace stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/model/
!/comparison/
!/common/
!/external/
!/data/
!/requirements.txt
!/THIRD_PARTY.md
/external/*
!/external/README.md
!/external/versions.json
!/external/COATI/
/external/COATI/*
!/external/COATI/README.md
/data/*
!/data/README.md
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.h5ad
**/*.h5
**/*.npz
**/*.npy
**/*.pt
**/*.pth
**/*.joblib
**/*.pkl
**/*.pickle
**/*.png
**/*.pdf
**/*.svg
**/*.log

# Data documentation; drafts and large inputs stay local.
!/data/RELEASE_PLAN.md
!/data/SOURCE_RIGHTS.md

# Explicit small-data release; do not allow arbitrary data artifacts.
!/data/processed/
/data/processed/*
!/data/processed/README.md
!/data/processed/manifest.json
!/data/processed/gastrulation/
/data/processed/gastrulation/*
!/data/processed/gastrulation/README.md
!/data/processed/gastrulation/rna.h5ad
!/data/processed/gastrulation/atac.h5ad
!/data/processed/gastrulation/rna_umap.png
!/data/processed/gastrulation/atac_umap.png
!/data/processed/human_cerebral/
/data/processed/human_cerebral/*
!/data/processed/human_cerebral/README.md
!/data/processed/human_cerebral/rna.h5ad
!/data/processed/human_cerebral/atac.h5ad
!/data/processed/human_cerebral/rna_umap.png
!/data/processed/human_cerebral/atac_umap.png
!/data/processed/palate/
/data/processed/palate/*
!/data/processed/palate/README.md
!/data/processed/palate/rna.h5ad
!/data/processed/palate/atac.h5ad
!/data/processed/palate/rna_umap.png
!/data/processed/palate/atac_umap.png
!/data/processed/pancreas/
/data/processed/pancreas/*
!/data/processed/pancreas/README.md
!/data/processed/pancreas/rna.h5ad
!/data/processed/pancreas/atac.h5ad
