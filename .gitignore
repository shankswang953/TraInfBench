# Publish only the lightweight, curated tree. Historical workspace stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/model/
!/comparison/
!/common/
!/external/
!/data/
!/requirements.txt
!/THIRD_PARTY.md
/external/*
!/external/README.md
!/external/versions.json
!/external/COATI/
/external/COATI/*
!/external/COATI/README.md
/data/*
!/data/README.md
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.h5ad
**/*.h5
**/*.npz
**/*.npy
**/*.pt
**/*.pth
**/*.joblib
**/*.pkl
**/*.pickle
**/*.png
**/*.pdf
**/*.svg
**/*.log
