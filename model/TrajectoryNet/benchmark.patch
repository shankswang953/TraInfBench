+def _format_timepoint(tp):
+    if isinstance(tp, (int, np.integer)):
+        return str(int(tp))
+    if isinstance(tp, (float, np.floating)) and float(tp).is_integer():
+        return str(int(tp))
+    return str(tp).replace("-", "m").replace(".", "p")
+
+
+def _nll_term_name(tp):
+    return "nll_time_" + _format_timepoint(tp)
+
+
+def _to_float(value):
+    if isinstance(value, torch.Tensor):
+        return float(value.detach().cpu().item())
+    return float(value)
+
+
+def _loss_log_fields(args, regularization_fns):
+    fields = [
+        "iter",
+        "total_loss",
+        "loss_before_cnf_regularization",
+        "nll_loss",
+        "nll_unweighted_mean",
+    ]
+    fields.extend(_nll_term_name(tp) for tp in args.timepoints)
+
+    if args.interp_reg:
+        fields.extend(["interp_reg_loss", "interp_reg_weighted"])
+    if args.vecint:
+        fields.extend(["vecint_loss", "vecint_weighted"])
+    if args.top_k_reg > 0:
+        fields.extend(["top_k_density_loss", "top_k_density_weighted"])
+
+    fields.append("cnf_regularization_total")
+    for reg_fn in regularization_fns:
+        name = INV_REGULARIZATION_FNS[reg_fn]
+        fields.extend([f"cnf_reg_{name}", f"cnf_reg_{name}_weighted"])
+    return fields
+
+
+def _append_loss_terms(save_dir, filename, fields, itr, terms):
+    utils.makedirs(save_dir)
+    path = os.path.join(save_dir, filename)
+    write_header = not os.path.exists(path)
+    row = {field: "" for field in fields}
+    row["iter"] = itr
+    for key, value in terms.items():
+        if key in row:
+            row[key] = _to_float(value)
+    with open(path, "a", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        if write_header:
+            writer.writeheader()
+        writer.writerow(row)
+
+
+def _add_cnf_regularization_terms(
+    loss, terms, model, regularization_coeffs, regularization_fns, include_in_total=True
+):
+    terms["loss_before_cnf_regularization"] = loss
+    terms["cnf_regularization_total"] = loss.new_tensor(0.0)
+    reg_states = ()
+    if len(regularization_coeffs) > 0:
+        reg_states = get_regularization(model, regularization_coeffs)
+        reg_loss = loss.new_tensor(0.0)
+        for reg_state, coeff, reg_fn in zip(
+            reg_states, regularization_coeffs, regularization_fns
+        ):
+            name = INV_REGULARIZATION_FNS[reg_fn]
+            weighted = reg_state * coeff
+            terms[f"cnf_reg_{name}"] = reg_state
+            terms[f"cnf_reg_{name}_weighted"] = weighted
+            if coeff != 0:
+                reg_loss = reg_loss + weighted
+        terms["cnf_regularization_total"] = reg_loss
+        if include_in_total:
+            loss = loss + reg_loss
+    terms["total_loss"] = loss
+    return loss, terms, reg_states
+
