+        """Normalize embedding, storing affine inverse params for trajectories."""
+        dim = embedding.shape[1]
+        mode = self.embedding_normalization
+
+        if mode in {"identity", "none"}:
+            self.mean_vals = np.zeros(dim, dtype=np.float64)
+            self.std_vals = np.ones(dim, dtype=np.float64)
+            return embedding.astype(np.float64, copy=False)
+
+        if mode in {"global_scale", "scale"}:
+            if self.embedding_scale is None:
+                raise ValueError("embedding_scale is required for global_scale normalization")
+            scale = float(self.embedding_scale)
+            if scale <= 0:
+                raise ValueError(f"embedding_scale must be positive, got {scale}")
+            self.mean_vals = np.zeros(dim, dtype=np.float64)
+            self.std_vals = np.full(dim, scale, dtype=np.float64)
+            return embedding.astype(np.float64, copy=False) / scale
+
+        if mode == "zscore":
+            if self.frozen_embedding_mean is None:
+                self.mean_vals = embedding.mean(axis=0)
+                std = embedding.std(axis=0)
+                self.std_vals = np.where(std == 0, 1.0, std)
+            else:
+                if self.frozen_embedding_mean.shape != (dim,):
+                    raise ValueError(
+                        "Frozen embedding mean has shape "
+                        f"{self.frozen_embedding_mean.shape}; expected {(dim,)}"
+                    )
+                if self.frozen_embedding_std.shape != (dim,):
+                    raise ValueError(
+                        "Frozen embedding std has shape "
+                        f"{self.frozen_embedding_std.shape}; expected {(dim,)}"
+                    )
+                if not np.all(np.isfinite(self.frozen_embedding_mean)):
+                    raise ValueError("Frozen embedding mean contains non-finite values")
+                if not np.all(np.isfinite(self.frozen_embedding_std)):
+                    raise ValueError("Frozen embedding std contains non-finite values")
+                if np.any(self.frozen_embedding_std <= 0):
+                    raise ValueError("Frozen embedding std must be strictly positive")
+                self.mean_vals = self.frozen_embedding_mean.copy()
+                self.std_vals = self.frozen_embedding_std.copy()
+            return (embedding - self.mean_vals) / self.std_vals
+
+        raise ValueError(
+            "embedding_normalization must be one of: identity, global_scale, zscore"
+        )
 
